// example of a program implementing theorem proving in an imperative manner in C With Theorems.

type_t nat_t = enum{
  z,
  nat_t succ(nat_t)
};

// for normal code, C-style declaration is fine.
// imperative-style code that wishes to use dependent typing stuff have all ptrs to mut data assumed to be updated and returned as params.

void add(nat_t a, nat_t b, nat_t* dst){
  *dst = switch a
    z = b,
    succ(x) = succ(add(x, b));
}

// theorem(result type) th_name(input);
theorem(add(a, 0, dst) == add(0, a, dst)) add0(nat_t a) = 
  switch a
    z = refl,
    succ(x) = succ(add0(x));

// '~' is used for universal function call syntax; it leads to prettier code without requiring method handling.
theorem add_commutative(nat_t a, nat_t b) -> add(a, b, dst) == add(b, a, dst) =
  switch a
    z = add0(b),
    succ(x) = add_commutative(x, b)~succ();
