// example of a program implementing theorem proving in an imperative manner in C With Theorems.

type_t nat_t = enum{
  z,
  nat_t succ(nat_t)
};

void add(nat_t a, nat_t b, nat_t* dst){
  *dst = switch a
    z = b,
    succ(x) = succ(add(x, b));
}

theorem add0(nat_t a){

}

(defthe (add-0 a nat_t) 
  (= (add a 0) (add 0 a))
)
(define (add-0 0) refl)
(define (add-0 (succ x)) 
  (succ (add-0 x))
)

(defthe (add-commutative a b) 
  (= (add a b) (add b a))
)
(define (add-commutative 0 b) (add-0 b))
(define (add-commutative (succ x) b)
  (succ (add-commutative x b))
)
