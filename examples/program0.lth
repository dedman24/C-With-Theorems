# example of a program in the Lisp With Theorems (lth) programming language.
# prototype of dependent typing in LISP.
# LISP syntax, however ugly, makes dependent type checking very simple.

(-- yes multi-line comments in lth are lisp statements how'd you know? )
(-- maybe one day add C-style /**/ comments, to break apart code. )
(--
 - we provide various functions to test all kinds of things regarding the lth interpreter.
 - hopefully it works.
 - provided here are examples of:
 -  circuit definitions,
 -  proofs using dependent types.
 - I don't really like how lth looks currently, but little can be done.
 - it's one of those ugly programming languages you HAVE to use & get used to. 
 - cry about it, see if I care.
--)

# deftype syntax ~
# (deftype TYPE-NAME CONTENTS)
(deftype nat_t (enum
  z
  (deffun (succ nat_t) nat_t)
))

# deffun syntax ~
# (deffun (FUNCTION-NAME ARGNAME ARGTYPE) DST-TYPE)
(deffun (add a nat_t b nat_t) nat_t)
(define (add 0 b) b)
(define (add (succ x) b) (succ (add x b)))

(defthe (add-0 a nat_t) 
  (= (add a 0) (add 0 a))
)
(define (add-0 0) refl)
(define (add-0 (succ x)) 
  (succ (add-0 x))
)

(defthe (add-commutative a b) 
  (= (add a b) (add b a))
)
(define (add-commutative 0 b) (add-0 b))
(define (add-commutative (succ x) b)
  (succ (add-commutative x b))
)
