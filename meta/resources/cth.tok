#
# novel cth qualifiers:
#   immut       ~ acts like consteval for functions & values in C++.
# novel cth types:
#   type_t      ~ types are first-class. typedef is used for scoped type definitions equivalent to using type_t immut.
#   subtype_t   ~ subtyping is supported; implicit conversion from a subtype to its master type is allowed _only when necessary_.
#   cth also lays out qualifiers in a more sensible manner; a ptr to an array of function ptrs taking void & returning void is written as:
#   void(void)*[]*        // idk what this would look like in C but I don't want to know.
#   but C ordering or a mixture of the two is also supported.
# C-inherited types:
#   int
#   char
#   enum
#   long
#   void
#   float
#   short
#   union
#   double
#   struct
#   long int
#   long long
#   short int
#   long double
#   long long int
# C-inherited qualifiers (therefore defined as qualifiers & not here):
#   auto
#   const
#   extern
#   signed
#   static
#   register
#   unsigned
#   volatile
# cth 1.0.0 is also to lack a preprocessor, which will come later.
